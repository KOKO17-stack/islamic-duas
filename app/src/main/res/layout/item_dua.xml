<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/cardBackground"
        app:cardUseCompatPadding="true"
        android:foreground="?attr/selectableItemBackground"
        android:clipChildren="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Gold top accent bar – keeps the gold identity inside the grid cell -->
            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#D4AF37" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/categoryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/categoryColor"
                    android:textStyle="normal"
                    android:letterSpacing="0.02"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="24sp"
                    android:textColor="@color/titleColor"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />

                <TextView
                    android:id="@+id/arabicText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textColor="@color/arabicColor"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="6dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/scheherazade_new" />

                <View
                    android:layout_width="72dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="center"
                    android:background="@color/primaryGold"
                    android:alpha="0.25" />

                <TextView
                    android:id="@+id/urduText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/urduColor"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/noto_nastaliq_urdu" />

            </LinearLayout>
        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
