<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F2A">

    <ScrollView
        android:id="@+id/huqooqScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="حقوق النساء"
                    android:textSize="22sp"
                    android:textColor="#D4AF37"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="آپ کے شرعی حقوق — قرآن و سنت کی روشنی میں"
                    android:textSize="13sp"
                    android:textColor="#C9A961"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center"
                    android:background="#D4AF37" />
            </LinearLayout>

            <!-- Section Sub-tabs -->
            <LinearLayout
                android:id="@+id/huqooqSubTabRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <TextView android:id="@+id/hSec0" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="دین" android:textSize="13sp" android:textColor="#D4AF37" android:background="@drawable/chip_selected" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="3dp" />
                <TextView android:id="@+id/hSec1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="مال" android:textSize="13sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="3dp" />
                <TextView android:id="@+id/hSec2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="عزت" android:textSize="13sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="3dp" />
                <TextView android:id="@+id/hSec3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="تعلیم" android:textSize="13sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="3dp" />
                <TextView android:id="@+id/hSec4" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="نکاح" android:textSize="13sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="3dp" />
                <TextView android:id="@+id/hSec5" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="فقہ النساء" android:textSize="11sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="3dp" />
            </LinearLayout>

            <!-- Section Description -->
            <TextView
                android:id="@+id/huqooqSectionDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/urdu_text"
                android:gravity="center"
                android:fontFamily="@font/noto_nastaliq_urdu" />

            <View
                android:id="@+id/huqooqDivider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#40D4AF37" />

            <!-- Evidences Container -->
            <LinearLayout
                android:id="@+id/huqooqEvidenceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:paddingVertical="12dp">

                <View android:layout_width="48dp" android:layout_height="1dp" android:background="#8B7355" android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تمام مواد صحیح اور مستند ذرائع سے ماخوذ ہے"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
