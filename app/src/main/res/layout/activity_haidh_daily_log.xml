<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/haidhDailyScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/haidhDailyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="🩸 آج کی کیفیت ریکارڈ کریں"
            android:textColor="@color/primaryGold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/haidhDailyDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:textColor="@color/mutedGold"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/haidhDailyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/haidhDailyNotes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_bg"
            android:fontFamily="sans-serif"
            android:hint="نوٹس لکھیں..."
            android:padding="10dp"
            android:textColor="@color/lightNeutral"
            android:textColorHint="#666666"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/haidhDailyCloseBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#334155"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="بند کریں"
                android:textColor="#E8E6E1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/haidhDailySaveBtn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#D4AF37"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="✅ محفوظ کریں"
                android:textColor="#0B0F2A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
