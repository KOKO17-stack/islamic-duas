<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F2A"
    android:padding="24dp">

    <TextView
        android:id="@+id/sessionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textColor="#D4AF37"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/sessionTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="۰۰:۰۰"
        android:textSize="36sp"
        android:textColor="#E8C547"
        android:gravity="center"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/sessionArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text=""
        android:textSize="22sp"
        android:textColor="#F0EDE8"
        android:gravity="center"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/sessionMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="#C9A961"
        android:gravity="center"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/sessionReflection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="#E0DDD8"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:fontFamily="serif" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/sessionStopBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ختم کریں"
            android:textSize="13sp"
            android:textColor="#EF4444"
            android:background="@drawable/rounded_bg"
            android:fontFamily="sans-serif"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/sessionNextBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:text="اگلا مرحلہ"
            android:textSize="13sp"
            android:textColor="#0B0F2A"
            android:background="#D4AF37"
            android:fontFamily="sans-serif"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionStepProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="#8B7355"
        android:gravity="center"
        android:fontFamily="sans-serif" />
</LinearLayout>
