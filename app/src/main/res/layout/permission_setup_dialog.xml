<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0F2A"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اجازتیں ترتیب دیں"
        android:textSize="20sp"
        android:textColor="#E8E6E1"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans-serif" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="بهتر کارکردگی کے لیے درکار اجازتیں"
        android:textSize="12sp"
        android:textColor="#C9A961"
        android:gravity="center"
        android:fontFamily="sans-serif" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#26D4AF37" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/permissionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- rows will be added programmatically -->

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/closeButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="بند کریں"
        android:textSize="14sp"
        android:backgroundTint="#16302C"
        android:textColor="#A8B8B4"
        android:textAllCaps="false" />

</LinearLayout>
