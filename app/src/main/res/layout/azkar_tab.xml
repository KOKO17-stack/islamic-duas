<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F2A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اللہ کی یاد میں سکون"
                android:textSize="18sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View android:layout_width="48dp" android:layout_height="2dp" android:layout_marginTop="8dp" android:background="#D4AF37" android:layout_gravity="center" />
        </LinearLayout>

        <!-- Interactive Tasbeeh -->
        <LinearLayout
            android:id="@+id/tasbeehCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تسبیح"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"
                android:background="@drawable/rounded_bg"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp">

                <TextView android:id="@+id/dhikrOption1" android:layout_width="wrap_content" android:layout_height="34dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="سبحان اللہ" android:textSize="12sp" android:textColor="#D4AF37" android:background="@drawable/chip_selected" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/dhikrOption2" android:layout_width="wrap_content" android:layout_height="34dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="الحمدللہ" android:textSize="12sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/dhikrOption3" android:layout_width="wrap_content" android:layout_height="34dp" android:paddingHorizontal="12dp" android:gravity="center" android:text="اللہ اکبر" android:textSize="12sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp">

                <View android:id="@+id/ringBg" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ring_bg" />

                <LinearLayout
                    android:id="@+id/tasbeehTapArea"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView android:id="@+id/tasbeehCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="56sp" android:textColor="#D4AF37" android:textStyle="bold" android:fontFamily="sans-serif-light" />
                    <TextView android:id="@+id/tasbeehDhikrText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سبحان اللہ" android:textSize="14sp" android:textColor="#E8E6E1" android:layout_marginTop="4dp" android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/tasbeehProgressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 33" android:textSize="11sp" android:textColor="#8B7355" android:fontFamily="sans-serif" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"
                android:background="@drawable/rounded_bg"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp">

                <TextView android:id="@+id/target33" android:layout_width="40dp" android:layout_height="30dp" android:gravity="center" android:text="33" android:textSize="12sp" android:textColor="#D4AF37" android:background="@drawable/chip_selected" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/target99" android:layout_width="40dp" android:layout_height="30dp" android:gravity="center" android:text="99" android:textSize="12sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/target100" android:layout_width="40dp" android:layout_height="30dp" android:gravity="center" android:text="100" android:textSize="12sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/target1000" android:layout_width="40dp" android:layout_height="30dp" android:gravity="center" android:text="1000" android:textSize="12sp" android:textColor="#8B7355" android:background="@drawable/chip_unselected" android:fontFamily="sans-serif" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView android:id="@+id/azkarSession" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today: 0" android:textSize="11sp" android:textColor="#8B7355" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/azkarStreaks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#8B7355" android:fontFamily="sans-serif" android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/azkarReset" android:layout_width="wrap_content" android:layout_height="30dp" android:paddingHorizontal="14dp" android:gravity="center" android:text="ری سیٹ" android:textSize="11sp" android:textColor="#8B7355" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Morning Adhkar -->
        <LinearLayout
            android:id="@+id/morningAdhkarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌅 صبح کے اذکار"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/morningAzkarProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="۰/۱۲"
                android:textSize="11sp"
                android:textColor="#10B981"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:id="@+id/morningAzkarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Evening Adhkar -->
        <LinearLayout
            android:id="@+id/eveningAdhkarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌇 شام کے اذکار"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/eveningAzkarProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="۰/۱۲"
                android:textSize="11sp"
                android:textColor="#10B981"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:id="@+id/eveningAzkarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- After-Salah Adhkar -->
        <LinearLayout
            android:id="@+id/afterSalahAdhkarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕌 بعد از نماز اذکار"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/afterSalahAzkarProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="۰/۵"
                android:textSize="11sp"
                android:textColor="#10B981"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:id="@+id/afterSalahAzkarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 99 Names Quick Access -->
        <LinearLayout
            android:id="@+id/ninetyNineNamesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ اللہ کے ۹۹ نام"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/ninetyNineNamesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="کسی نام پر کلک کریں — اس کا معنی دیکھیں"
                android:textSize="11sp"
                android:textColor="#C9A961"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/ninetyNineNamesDisplay"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text=""
                android:textSize="18sp"
                android:textColor="#F0EDE8"
                android:fontFamily="serif"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_bg" />

            <TextView
                android:id="@+id/ninetyNineNamesMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#E0DDD8"
                android:gravity="center"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Word Analysis -->
        <LinearLayout
            android:id="@+id/wordAnalysisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📖 لفظی تجزیہ"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/wordAnalysisDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="#F0EDE8"
                android:gravity="center"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/wordAnalysisMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#E0DDD8"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/wordAnalysisNext"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="اگلا"
                android:textSize="12sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
