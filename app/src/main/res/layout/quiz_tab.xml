<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 اسلامی کوئز"
                android:textSize="20sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="قرآن، حدیث، فقہ، سیرت، خواتین کے حقوق، صحابہ اور تاریخ اسلام پر مبنی 100+ سوالات — اپنی معلومات بڑھائیں"
                android:textSize="13sp"
                android:textColor="#A8B8B4"
                android:gravity="center"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Topic Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:weightSum="7">

            <TextView
                android:id="@+id/qtTopicQuran"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="قرآن"
                android:textSize="11sp"
                android:textColor="#D4AF6A"
                android:background="@drawable/chip_selected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="1dp" />

            <TextView
                android:id="@+id/qtTopicHadith"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="حدیث"
                android:textSize="11sp"
                android:textColor="#8B7355"
                android:background="@drawable/chip_unselected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="1dp" />

            <TextView
                android:id="@+id/qtTopicFiqh"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="فقہ"
                android:textSize="11sp"
                android:textColor="#8B7355"
                android:background="@drawable/chip_unselected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="1dp" />

            <TextView
                android:id="@+id/qtTopicSeerah"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="سیرت"
                android:textSize="11sp"
                android:textColor="#8B7355"
                android:background="@drawable/chip_unselected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="1dp" />

            <TextView
                android:id="@+id/qtTopicWomen"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="خواتین"
                android:textSize="10sp"
                android:textColor="#8B7355"
                android:background="@drawable/chip_unselected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="1dp" />

            <TextView
                android:id="@+id/qtTopicSahaba"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="صحابہ"
                android:textSize="10sp"
                android:textColor="#8B7355"
                android:background="@drawable/chip_unselected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="1dp" />

            <TextView
                android:id="@+id/qtTopicHistory"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="تاریخ"
                android:textSize="10sp"
                android:textColor="#8B7355"
                android:background="@drawable/chip_unselected"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="1dp" />
        </LinearLayout>

        <!-- Quick Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_bg"
            android:padding="10dp">

            <TextView
                android:id="@+id/qtBestScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏆 بہترین: —"
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/qtTotalCorrect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✅ کل: —"
                android:textSize="13sp"
                android:textColor="#A8B8B4"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/qtStreak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔥 تسلسل: —"
                android:textSize="13sp"
                android:textColor="#E0A83E"
                android:gravity="center"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Start Button -->
        <TextView
            android:id="@+id/qtStartBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="🚀 کوئز شروع کریں"
            android:textSize="17sp"
            android:textColor="#D4AF6A"
            android:textStyle="bold"
            android:background="@drawable/rounded_bg"
            android:fontFamily="sans-serif"
            android:clickable="true"
            android:focusable="true" />

        <!-- Info section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:background="@drawable/rounded_bg"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 کیسے کام کرتا ہے؟"
                android:textSize="15sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 7 موضوعات پر 500+ سوالات\n• متعدد موضوعات ایک ساتھ منتخب کریں\n• غلط جوابات دوبارہ آئیں گے تاکہ سیکھ سکو\n• روزانہ چیلنج — ہر روز 10 نئے سوالات\n• اپنی کمزوری پہچانیں اور بہتری لائیں"
                android:textSize="13sp"
                android:textColor="#A8B8B4"
                android:lineSpacingExtra="3dp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Badge / Challenge link -->
        <TextView
            android:id="@+id/qtDailyChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#8FBF8A"
            android:gravity="center"
            android:fontFamily="sans-serif" />

    </LinearLayout>
</ScrollView>
