<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/medPromptRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0B0F2A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_elevated_gold_border"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/medDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:text="💊 دوا کی یاد"
            android:textColor="#E8C547"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/medDialogName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:text="دوائی"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/medDialogTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:text="کیا دوا لے لی؟"
            android:textColor="#C9A961"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="sans-serif" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/medDialogLaterBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:background="#D4AF37"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:text="🔔 بعد میں"
                android:textColor="#0B0F2A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/medDialogTakenBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:background="#8FBF8A"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:text="✅ لے لی"
                android:textColor="#0B0F2A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
