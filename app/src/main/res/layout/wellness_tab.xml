<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wellnessScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F2A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="صحت و سکون"
                android:textSize="20sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View android:layout_width="48dp" android:layout_height="2dp" android:layout_marginTop="8dp" android:background="#D4AF37" android:layout_gravity="center" />
        </LinearLayout>

        <!-- Haidh / Cycle Hero Card -->
        <LinearLayout
            android:id="@+id/haidhHeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:orientation="vertical"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌸 حیض و طہارت ٹریکر"
                android:textSize="20sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/haidhStatusTuhr"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🟢 طہارت"
                    android:textSize="14sp"
                    android:textColor="#22C55E"
                    android:background="@drawable/chip_selected"
                    android:fontFamily="sans-serif"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/haidhStatusHaidh"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔴 حیض"
                    android:textSize="14sp"
                    android:textColor="#EF4444"
                    android:background="@drawable/chip_unselected"
                    android:fontFamily="sans-serif"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginHorizontal="3dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/haidhHeroState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🟢 حالت: طہارت"
                android:textSize="26sp"
                android:textColor="#22C55E"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/haidhHeroCycleDay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📅 سائیکل کا دن: —"
                    android:textSize="15sp"
                    android:textColor="#C9A961"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/haidhHeroNextPeriod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏳ اگلا: —"
                    android:textSize="15sp"
                    android:textColor="#A8B8B4"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="#2A4A44" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/haidhHeroQada"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="روزے: 0 | نماز: 0"
                    android:textSize="14sp"
                    android:textColor="#A8B8B4"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/haidhHeroOpenBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🌸 کھولیں"
                    android:textSize="15sp"
                    android:textColor="#D4AF6A"
                    android:background="@drawable/rounded_bg"
                    android:fontFamily="sans-serif"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Exercise Log - Super Prominent Card -->
        <LinearLayout
            android:id="@+id/exerciseLogCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏃 ورزش لاگ -- صحت کے لیے سنت"
                android:textSize="18sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View android:layout_width="48dp" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="#D4AF37" android:layout_gravity="center" />

            <TextView
                android:id="@+id/exerciseLogMinutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="آج: 0 منٹ"
                android:textSize="16sp"
                android:textColor="@color/urdu_text"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/exerciseLogWeekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="اس ہفتے: 0/4 ورزشیں"
                android:textSize="14sp"
                android:textColor="#A8B8B4"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/exerciseLogRecordBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🏃 ریکارڈ کریں"
                    android:textSize="15sp"
                    android:textColor="#D4AF6A"
                    android:background="@drawable/rounded_bg"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/exerciseLogOpenBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📊 مکمل لاگ"
                    android:textSize="15sp"
                    android:textColor="#D4AF6A"
                    android:background="@drawable/rounded_bg"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Medication Card -->
        <LinearLayout
            android:id="@+id/medicineBigCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:orientation="vertical"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="💊 دوائیں"
                    android:textSize="18sp"
                    android:textColor="#D4AF6A"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/addMedicationBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="➕ دوا شامل کریں\n📌 یاد دہانی کے لیے"
                    android:textSize="12sp"
                    android:textColor="#0B0F2A"
                    android:background="#D4AF37"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>

            <View android:layout_width="48dp" android:layout_height="1dp"
                  android:layout_marginVertical="8dp" android:background="#D4AF37" android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/medicationFullList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Al-Anis Emotional Companion -->
        <LinearLayout
            android:id="@+id/anisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الأنیس — دل کا سکون"
                android:textSize="17sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="آج کیسا محسوس کر رہی ہیں؟"
                android:textSize="15sp"
                android:textColor="@color/arabic_text"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/anisSadBtn" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="😢 اداس" android:textSize="14sp" android:textColor="@color/arabic_text" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/anisLonelyBtn" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="😔 تنہا" android:textSize="14sp" android:textColor="@color/arabic_text" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="4dp" />
                <TextView android:id="@+id/anisAnxiousBtn" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="😟 پریشان" android:textSize="14sp" android:textColor="@color/arabic_text" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="4dp" />
                <TextView android:id="@+id/anisGratefulBtn" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="😊 شکر" android:textSize="14sp" android:textColor="@color/arabic_text" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/anisResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/urdu_text"
            android:lineSpacingExtra="8dp"
            android:fontFamily="@font/noto_nastaliq_urdu"
            android:visibility="gone" />
        </LinearLayout>

        <!-- Exercise Benefits — Prominent -->
        <LinearLayout
            android:id="@+id/exerciseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏃‍♀️ ورزش — صحت کے لیے سنت"
                android:textSize="18sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View android:layout_width="48dp" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="#D4AF37" android:layout_gravity="center" />

            <TextView
                android:id="@+id/exerciseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="چہل قدمی (Walking)"
                android:textSize="16sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/exerciseDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="نبی کریم ﷺ نے فرمایا: تم میں سب سے بہتر وہ ہے جو اپنی دنیا اور آخرت دونوں کے لیے کام کرے۔ روزانہ 30 منٹ کی چہل قدمی دل کی صحت، وزن میں کمی، اور ذہنی سکون کے لیے مفید ہے۔"
                android:textSize="14sp"
                android:textColor="@color/urdu_text"
                android:lineSpacingExtra="3dp"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/exercisePrev" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="14sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/exerciseNext" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="14sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Parenting Tips -->
        <LinearLayout
            android:id="@+id/parentingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👶 بچوں کی سنتی تربیت"
                android:textSize="17sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/parentingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="15sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/parentingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/urdu_text"
                android:lineSpacingExtra="6dp"
                android:fontFamily="@font/noto_nastaliq_urdu" />

            <TextView
                android:id="@+id/parentingSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/parentingPrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="13sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/parentingNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="13sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Taharah & Health -->
        <LinearLayout
            android:id="@+id/taharahCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🫧 طہارت و صحت"
                android:textSize="17sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/taharahTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="15sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/taharahContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/urdu_text"
                android:lineSpacingExtra="6dp"
                android:fontFamily="@font/noto_nastaliq_urdu" />

            <TextView
                android:id="@+id/taharahSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/taharahPrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="13sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/taharahNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="13sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sujood al-Sahw -->
        <LinearLayout
            android:id="@+id/sujoodCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕌 سہو کے سجدے کا مسئلہ"
                android:textSize="17sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/openSujoodSahw"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="مسئلہ حل کریں"
                android:textSize="14sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bedtime Wind-Down -->
        <LinearLayout
            android:id="@+id/bedtimeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌙 سونے سے پہلے"
                android:textSize="17sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/openBedtime"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="سونے کا سنت طریقہ"
                android:textSize="14sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- More / مزید Card -->
        <LinearLayout
            android:id="@+id/moreCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☰ مزید"
                android:textSize="18sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View
                android:layout_width="48dp"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#D4AF37"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/moreContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
