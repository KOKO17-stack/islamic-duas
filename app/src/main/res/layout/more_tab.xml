<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F2A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مزید"
                android:textSize="18sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <View android:layout_width="48dp" android:layout_height="2dp" android:layout_marginTop="8dp" android:background="#D4AF37" android:layout_gravity="center" />
        </LinearLayout>

        <!-- Comparative Fiqh -->
        <LinearLayout
            android:id="@+id/comparativeFiqhCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 تقابلی فقہ"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/fiqhTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/fiqhTopicDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/fiqhEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="#F0EDE8"
                android:gravity="end"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/fiqhSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="9sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/fiqhNextTopic"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="اگلا موضوع"
                android:textSize="12sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Fiqh Scenarios -->
        <LinearLayout
            android:id="@+id/fiqhScenarioCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❓ فقہی سوال"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/scenarioQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#E8E6E1"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:id="@+id/scenarioOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/scenarioExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#10B981"
                android:fontFamily="serif"
                android:visibility="gone" />

            <TextView
                android:id="@+id/scenarioNext"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="اگلا سوال"
                android:textSize="12sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Challenges -->
        <LinearLayout
            android:id="@+id/challengeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 چیلنجز"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/challengeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/challengeDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/challengeNext"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="اگلا چیلنج"
                android:textSize="12sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Prayer Education -->
        <LinearLayout
            android:id="@+id/prayerEducationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📖 دینی تعلیم"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/lessonTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/lessonContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:lineSpacingExtra="3dp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/lessonNext"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="اگلا سبق"
                android:textSize="12sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Seerah -->
        <LinearLayout
            android:id="@+id/seerahCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕋 سیرت النبی ﷺ"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/seerahTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/seerahContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:lineSpacingExtra="3dp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/seerahSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/seerahPrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/seerahNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fadail A'mal -->
        <LinearLayout
            android:id="@+id/fadailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ فضائل اعمال"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/fadailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/fadailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:lineSpacingExtra="3dp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/fadailSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/fadailPrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/fadailNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dawah Tips -->
        <LinearLayout
            android:id="@+id/dawahCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📢 دعوتی نکات"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/dawahTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/dawahContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:lineSpacingExtra="3dp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/dawahSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/dawahPrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/dawahNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Home Economy -->
        <LinearLayout
            android:id="@+id/economyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 گھریلو معیشت"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/economyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="#C9A961"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/economyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:lineSpacingExtra="3dp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/economySource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#8B7355"
                android:gravity="end"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/economyPrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="پچھلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/economyNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="اگلا" android:textSize="11sp" android:textColor="#D4AF37" android:background="@drawable/rounded_bg" android:fontFamily="sans-serif" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quiz -->
        <LinearLayout
            android:id="@+id/quizCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 اسلامی کوئز — اپنے علم کی جانچ کریں"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="قرآن، حدیث، فقہ اور سیرت پر مبنی ۴۰+ سوالات — اپنی معلومات بڑھائیں"
                android:textSize="11sp"
                android:textColor="#C9A961"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/startQuizBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="کوئز شروع کریں"
                android:textSize="13sp"
                android:textColor="#D4AF37"
                android:background="@drawable/rounded_bg"
                android:fontFamily="sans-serif"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Badges -->
        <!-- Analytics / Stats -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 ہفتہ وار اعدادوشمار"
                android:textSize="15sp"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/statsWeeklyAvg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0DDD8"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/statsMoodTrend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#C9A961"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Reward Dashboard -->
        <LinearLayout
            android:id="@+id/rewardDashboardCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_elevated_gold_border"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💎 جواہر ڈیش بورڈ"
                android:textSize="15sp"
                android:textColor="#D4AF6A"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/rwdGems"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#D4AF6A"
                    android:gravity="center"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <TextView
                android:id="@+id/rwdStreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#C9A961"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/rwdMissed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#E0645A"
                android:gravity="center"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:paddingVertical="12dp">

            <View android:layout_width="48dp" android:layout_height="1dp" android:background="#8B7355" android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أهل الحديث ریسرچ سینٹر — السعودية و باكستان"
                android:textSize="10sp"
                android:textColor="#8B7355"
                android:gravity="center"
                android:fontFamily="sans-serif" />
            <TextView
                android:layout_width="match_parent"
