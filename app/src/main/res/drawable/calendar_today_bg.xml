<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/default_calendar_bg" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Gold ring border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/primary_gold" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>