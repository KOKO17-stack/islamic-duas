<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- MAP - Fills all available screen space above the bottom panel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_card">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Playhead timestamp overlay on map -->
        <TextView
            android:id="@+id/playheadTimeDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:background="#CC000000"
            android:text="@string/playhead_time_label"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- COMPACT BOTTOM PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_card">

        <!-- ROW A: Filters (time range + accuracy) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/btnDateRange"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:padding="6dp"
                android:text="@string/time_filter_all"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/accuracyFilterSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip" />

            <ImageButton
                android:id="@+id/btnClearDate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:scaleType="centerInside"
                android:contentDescription="Clear time filter"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ROW B: Playback controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/playBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="30dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_play_btn"
                android:text="\u25B6 Play"
                android:textColor="@color/text_on_accent"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/countText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/percentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="0%" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed: "
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/speedSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ROW C: Seekbar -->
        <SeekBar
            android:id="@+id/scrubber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <!-- ROW D: Stats (2 compact rows of 3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <TextView
                    android:id="@+id/stPoints"
                    style="@style/PbStat"
                    android:text="0 pts" />
                <TextView
                    android:id="@+id/stDuration"
                    style="@style/PbStat"
                    android:text="--" />
                <TextView
                    android:id="@+id/stDistance"
                    style="@style/PbStat"
                    android:text="--" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <TextView
                    android:id="@+id/stMaxSpeed"
                    style="@style/PbStat"
                    android:text="Max --" />
                <TextView
                    android:id="@+id/stAvgSpeed"
                    style="@style/PbStat"
                    android:text="Avg --" />
                <TextView
                    android:id="@+id/stAltGain"
                    style="@style/PbStat"
                    android:text="Alt +0m" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW E: Action buttons + range caption -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageButton
                android:id="@+id/btnExport"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                android:scaleType="centerInside"
                android:contentDescription="Export GPX" />

            <ImageButton
                android:id="@+id/btnLoop"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_ff"
                android:scaleType="centerInside"
                android:contentDescription="Loop" />

            <ImageButton
                android:id="@+id/btnFollow"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_compass"
                android:scaleType="centerInside"
                android:contentDescription="Auto-follow" />

            <ImageButton
                android:id="@+id/btnEnd"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_ff"
                android:scaleType="centerInside"
                android:contentDescription="Jump to end" />

            <ImageButton
                android:id="@+id/btnMapType"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_mapmode"
                android:scaleType="centerInside"
                android:contentDescription="Map type" />

            <TextView
                android:id="@+id/pbRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- POINT LIST (tap header to expand/collapse) -->
        <TextView
            android:id="@+id/pointListHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:clickable="true"
            android:focusable="true"
            android:text="\u25B8 \uD83D\uDCCD Playback points" />

        <ScrollView
            android:id="@+id/pointListScroll"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:scrollbars="vertical"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/pointList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
