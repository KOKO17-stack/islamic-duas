<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/storageRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾 Storage &amp; Cleanup"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingStart="4dp" />

            <TextView
                android:id="@+id/storageRefresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="🔄"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/storageHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#d1d9e0"
            android:textSize="13sp"
            android:padding="4dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:id="@+id/categoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/largestHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Largest Items"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:id="@+id/largestList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧹 Cleanup Actions"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:background="#ffd54f"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Media Cleanup"
                    android:textColor="#ffd54f"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDeletePhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_media"
                android:gravity="center"
                android:padding="13dp"
                android:text="📸  Delete All Photos"
                android:textColor="#ffd54f"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_media"
                android:gravity="center"
                android:padding="13dp"
                android:text="🎬  Delete Videos"
                android:textColor="#ffd54f"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteVoiceNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_media"
                android:gravity="center"
                android:padding="13dp"
                android:text="🎤  Delete Voice Notes"
                android:textColor="#ffd54f"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteRecordings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_media"
                android:gravity="center"
                android:padding="13dp"
                android:text="🎙️  Delete Remote Recordings"
                android:textColor="#ffd54f"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnClearRecStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_media"
                android:gravity="center"
                android:padding="13dp"
                android:text="🧹  Clear recordingStatus"
                android:textColor="#ffd54f"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:background="#79c0ff"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Cleanup"
                    android:textColor="#79c0ff"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDeleteTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_data"
                android:gravity="center"
                android:padding="13dp"
                android:text="📞  Delete Timeline"
                android:textColor="#79c0ff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_data"
                android:gravity="center"
                android:padding="13dp"
                android:text="📊  Delete App Usage"
                android:textColor="#79c0ff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_data"
                android:gravity="center"
                android:padding="13dp"
                android:text="📍  Delete Location History"
                android:textColor="#79c0ff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteBrowser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_data"
                android:gravity="center"
                android:padding="13dp"
                android:text="🌐  Delete Browser History"
                android:textColor="#79c0ff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/btnDeleteWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_data"
                android:gravity="center"
                android:padding="13dp"
                android:text="📡  Delete WiFi Scans"
                android:textColor="#79c0ff"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_danger"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:background="#ff6b6b"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️  Danger Zone"
                    android:textColor="#ff6b6b"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDeleteEverything"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_danger"
                android:gravity="center"
                android:padding="16dp"
                android:text="⚠️  DELETE EVERYTHING"
                android:textColor="#ff6b6b"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sizes are estimates from sampled entries (like the web dashboard)."
            android:textColor="#8b949e"
            android:textSize="12sp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
