<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/storageRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/storageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Storage"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:padding="4dp" />

        <TextView
            android:id="@+id/storageHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:padding="4dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/categoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/largestHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Largest Items"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:paddingTop="14dp" />

        <LinearLayout
            android:id="@+id/largestList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sizes are estimates from sampled entries (like the web dashboard)."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>